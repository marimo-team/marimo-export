{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>marimo-team/.github:renovate-config"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Match the browser provider to Vitest bundled by Vite+ 1.0.",
      "matchPackageNames": ["@vitest/browser-playwright"],
      "allowedVersions": "5.0.1"
    },
    {
      "description": "agent-plugins requires tomli 2.3.1 on supported Python 3.10.",
      "matchPackageNames": ["tomli"],
      "allowedVersions": "/^2\\.3\\.1$/"
    }
  ]
}
