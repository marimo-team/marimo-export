{
  "name": "@marimo-team/marimo-export-parquet",
  "version": "0.0.0",
  "description": "Parquet loader for marimo exports.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run -t build",
    "test": "vp test"
  },
  "dependencies": {
    "@marimo-team/marimo-export": "workspace:*",
    "hyparquet": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
