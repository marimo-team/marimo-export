{
  "name": "@marimo-team/export-loader-parquet",
  "version": "0.0.0",
  "description": "Parquet dataframe loader for marimo export bundles.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@marimo-team/export-reader": "workspace:*",
    "hyparquet": "^1.25.8"
  }
}
