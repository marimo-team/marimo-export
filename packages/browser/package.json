{
  "name": "@marimo-team/marimo-export",
  "version": "0.0.0",
  "description": "Read and render portable marimo notebook publications in a browser",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp pack",
    "test": "vp test",
    "test:package": "node tests/packed-install.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@msgpack/msgpack": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
