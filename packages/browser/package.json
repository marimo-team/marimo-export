{
  "name": "@marimo-team/marimo-export",
  "version": "0.0.0",
  "description": "Load prepared marimo notebook results in browser applications",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./loader/anywidget": "./src/loader/anywidget.ts",
    "./loader/arrow": "./src/loader/arrow.ts",
    "./loader/numpy": "./src/loader/numpy.ts",
    "./loader/parquet": "./src/loader/parquet.ts",
    "./loader/vegalite": "./src/loader/vegalite.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./loader/anywidget": {
        "types": "./dist/loader/anywidget.d.mts",
        "import": "./dist/loader/anywidget.mjs"
      },
      "./loader/arrow": {
        "types": "./dist/loader/arrow.d.mts",
        "import": "./dist/loader/arrow.mjs"
      },
      "./loader/numpy": {
        "types": "./dist/loader/numpy.d.mts",
        "import": "./dist/loader/numpy.mjs"
      },
      "./loader/parquet": {
        "types": "./dist/loader/parquet.d.mts",
        "import": "./dist/loader/parquet.mjs"
      },
      "./loader/vegalite": {
        "types": "./dist/loader/vegalite.d.mts",
        "import": "./dist/loader/vegalite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp pack",
    "test": "vp test",
    "test:package": "node tests/packed-install.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "catalog:"
  },
  "devDependencies": {
    "@anywidget/types": "catalog:",
    "@types/node": "catalog:",
    "@uwdata/flechette": "catalog:",
    "hyparquet": "catalog:",
    "lz4js": "catalog:",
    "typescript": "catalog:",
    "vega-embed": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@anywidget/types": "^0.4.0",
    "@uwdata/flechette": "^2.5.0",
    "hyparquet": "^1.26.2",
    "lz4js": "0.2.0",
    "vega-embed": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@anywidget/types": {
      "optional": true
    },
    "@uwdata/flechette": {
      "optional": true
    },
    "hyparquet": {
      "optional": true
    },
    "lz4js": {
      "optional": true
    },
    "vega-embed": {
      "optional": true
    }
  }
}
