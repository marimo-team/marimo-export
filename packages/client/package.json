{
  "name": "@marimo-team/export-client",
  "version": "0.1.0",
  "description": "Client for asking a live marimo session to produce export bundles.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "test": "pnpm build && node --test test/*.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@marimo-team/marimo-api": "github:marimo-team/marimo#0.23.4&path:/packages/openapi"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
