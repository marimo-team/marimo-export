{
  "name": "@marimo-team/marimo-export",
  "version": "0.0.0",
  "description": "Publish and consume portable marimo notebook outputs",
  "license": "Apache-2.0",
  "bin": {
    "marimo-export": "./bin/marimo-export.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./remote": "./src/remote.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./remote": {
        "types": "./dist/remote.d.mts",
        "import": "./dist/remote.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp pack",
    "test": "vp test",
    "test:package": "node tests/packed-install.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
