MARIMO_SERVER_URL=http://localhost:8483
# Leave empty when the marimo server was started without a token.
MARIMO_SERVER_TOKEN=
MARIMO_NOTEBOOK=notebooks/finance.py
# Optional: use this instead of MARIMO_NOTEBOOK when multiple live sessions
# match the same notebook path.
# MARIMO_SESSION_ID=s_...
MARIMO_CAPTURE=0
# Optional: set to 1/true/force to statically render archive-backed routes by
# capturing in-memory bundles during next build.
MARIMO_ARCHIVE_CAPTURE=0
