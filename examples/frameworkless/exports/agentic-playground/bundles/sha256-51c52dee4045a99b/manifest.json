      "values": {
        "summary": {
          "source": {
            "type": "definition",
            "name": "summary"
          },
          "formats": {
            "json": {
              "export": {
                "type": "code",
                "code": "import json\n\n\ndef export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"summary.json\",\n        json.dumps(value, allow_nan=False, indent=2).encode(\"utf-8\"),\n        media_type=\"application/json\",\n    )\n    return ctx.artifact(\n        format=\"playground.summary.json.v1\",\n        media_type=\"application/json\",\n        files={\"data\": blob},\n        entry=\"data\",\n        metadata={\n            \"kind\": \"scenario-summary\",\n            \"region\": value[\"region\"],\n            \"mode\": value[\"mode\"],\n        },\n    )\n"
              }
            }
          }
        },
        "records": {
          "source": {
            "type": "definition",
            "name": "rows"
          },
          "formats": {
            "json": {
              "export": {
                "type": "code",
                "code": "import json\n\n\ndef export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"records.json\",\n        json.dumps(value, allow_nan=False, indent=2).encode(\"utf-8\"),\n        media_type=\"application/json\",\n    )\n    return ctx.artifact(\n        format=\"playground.records.json.v1\",\n        media_type=\"application/json\",\n        files={\"data\": blob},\n        entry=\"data\",\n        metadata={\n            \"kind\": \"timeseries-records\",\n            \"rows\": len(value),\n            \"columns\": list(value[0]) if value else [],\n        },\n    )\n"
              }
            }
          }
        },
        "sparkline": {
          "source": {
            "type": "definition",
            "name": "sparkline_svg"
          },
          "formats": {
            "svg": {
              "export": {
                "type": "code",
                "code": "def export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"sparkline.svg\",\n        value.encode(\"utf-8\"),\n        media_type=\"image/svg+xml\",\n    )\n    return ctx.artifact(\n        format=\"playground.sparkline.svg.v1\",\n        media_type=\"image/svg+xml\",\n        files={\"image\": blob},\n        entry=\"image\",\n        metadata={\n            \"kind\": \"sparkline\",\n            \"viewbox\": \"0 0 720 240\",\n        },\n    )\n"
              }
            }
          }
        },
        "note": {
          "source": {
            "type": "definition",
            "name": "market_note"
          },
          "formats": {
            "html": {
              "export": {
                "type": "code",
                "code": "def export(value, ctx, **options):\n    html = value.text if hasattr(value, \"text\") else str(value)\n    blob = ctx.write_blob(\n        \"note.html\",\n        html.encode(\"utf-8\"),\n        media_type=\"text/html\",\n    )\n    return ctx.artifact(\n        format=\"playground.note.html.v1\",\n        media_type=\"text/html\",\n        files={\"html\": blob},\n        entry=\"html\",\n        metadata={\n            \"kind\": \"marimo-markdown-output\",\n        },\n    )\n"
              }
            }
          }
        }
