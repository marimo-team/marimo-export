            "json": {
              "export": {
                "type": "code",
                "code": "import json\n\n\ndef export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"summary.json\",\n        json.dumps(value, allow_nan=False, indent=2).encode(\"utf-8\"),\n        media_type=\"application/json\",\n    )\n    return ctx.artifact(\n        format=\"playground.summary.json.v1\",\n        media_type=\"application/json\",\n        files={\"data\": blob},\n        entry=\"data\",\n        metadata={\n            \"kind\": \"scenario-summary\",\n            \"region\": value[\"region\"],\n            \"mode\": value[\"mode\"],\n        },\n    )\n"
              }
            }
          }
        },
