          "source": "rows",
          "formats": {
            "json": {
              "export": {
                "type": "code",
                "code": "import json\n\n\ndef export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"records.json\",\n        json.dumps(value, allow_nan=False, indent=2).encode(\"utf-8\"),\n        media_type=\"application/json\",\n    )\n    return ctx.artifact(\n        format=\"playground.records.json.v1\",\n        media_type=\"application/json\",\n        files={\"data\": blob},\n        entry=\"data\",\n        metadata={\n            \"kind\": \"timeseries-records\",\n            \"rows\": len(value),\n            \"columns\": list(value[0]) if value else [],\n        },\n    )\n"
              }
            }
          }
        },
