                "code": "def export(value, ctx, **options):\n    blob = ctx.write_blob(\n        \"sparkline.svg\",\n        value.encode(\"utf-8\"),\n        media_type=\"image/svg+xml\",\n    )\n    return ctx.artifact(\n        format=\"playground.sparkline.svg.v1\",\n        media_type=\"image/svg+xml\",\n        files={\"image\": blob},\n        entry=\"image\",\n        metadata={\n            \"kind\": \"sparkline\",\n            \"viewbox\": \"0 0 720 240\",\n        },\n    )\n"
              }
            }
          }
        },
        "note": {
          "source": "market_note",
          "formats": {
            "html": {
              "export": {
                "type": "code",
                "code": "def export(value, ctx, **options):\n    html = value.text if hasattr(value, \"text\") else str(value)\n    blob = ctx.write_blob(\n        \"note.html\",\n        html.encode(\"utf-8\"),\n        media_type=\"text/html\",\n    )\n    return ctx.artifact(\n        format=\"playground.note.html.v1\",\n        media_type=\"text/html\",\n        files={\"html\": blob},\n        entry=\"html\",\n        metadata={\n            \"kind\": \"marimo-markdown-output\",\n        },\n    )\n"
              }
            }
          }
        }
      }
