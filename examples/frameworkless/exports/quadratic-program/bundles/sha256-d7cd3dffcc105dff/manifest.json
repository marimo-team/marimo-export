    "summary": {
      "source": {
        "type": "expression",
        "expression": "{\n  \"P\": np.asarray(P, dtype=float).tolist(),\n  \"q\": np.asarray(q, dtype=float).tolist(),\n  \"G\": np.asarray(G, dtype=float).tolist(),\n  \"h\": np.asarray(h, dtype=float).tolist(),\n  \"x\": np.asarray(x.value, dtype=float).tolist(),\n  \"objective\": float(problem.value),\n  \"dual\": np.asarray(problem.constraints[0].dual_value, dtype=float).tolist(),\n  \"slack\": np.asarray(h - G @ x.value, dtype=float).tolist(),\n  \"eigenvalues\": np.linalg.eigvalsh(P).tolist(),\n  \"condition_number\": float(np.linalg.cond(P)),\n}"
      },
      "formats": ["json"]
    },
