---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { catalogStats, getCatalog, groupByTopic } from "@/lib/catalog";

const catalog = await getCatalog();
const groups = groupByTopic(catalog.notebooks);
const stats = catalogStats(catalog.notebooks);
---

<BaseLayout title="marimo learn gallery">
  <main class="site-shell">
    <section class="hero-band">
      <div>
        <p class="eyebrow">marimo learn</p>
        <h1>Notebook gallery</h1>
        <p class="lede">
          A static Astro page built from the notebook list exposed by a running marimo
          workspace. This example only demonstrates discovery, metadata extraction, grouping,
          and gallery rendering.
        </p>
      </div>
      <dl class="metrics" aria-label="Gallery summary">
        <div><dt>sources</dt><dd>{stats.total}</dd></div>
        <div><dt>topics</dt><dd>{stats.topics}</dd></div>
        <div><dt>cells</dt><dd>{stats.cells}</dd></div>
      </dl>
    </section>

    <section class="topic-groups" aria-label="Notebook topics">
      {
        groups.map((group) => (
          <section id={`topic-${group.topic}`} class="topic-section">
            <header class="topic-header">
              <div>
                <p class="eyebrow">{group.topic}</p>
                <h2>{group.title}</h2>
              </div>
              <span>{group.notebooks.length} notebooks</span>
            </header>
            <div class="notebook-grid">
              {group.notebooks.map((notebook) => (
                <article class="notebook-card" id={notebook.slug}>
                  <span>
                    <strong>{notebook.title}</strong>
                    {notebook.description && <p>{notebook.description}</p>}
                    <small>{notebook.path}</small>
                  </span>
                  <em>{notebook.cell_count} cells</em>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </main>
</BaseLayout>
