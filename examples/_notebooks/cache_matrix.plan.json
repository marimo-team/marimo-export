{
  "schema": "marimo-export.plan.v1",
  "inputs": {
    "scale": {
      "definition": "scale",
      "default": 2
    },
    "multiplier": {
      "ui": "multiplier",
      "default": 2
    }
  },
  "scenarios": [
    {
      "id": "baseline",
      "inputs": {}
    },
    {
      "id": "triple",
      "inputs": { "multiplier": 3 }
    },
    {
      "id": "large",
      "inputs": { "scale": 5, "multiplier": 3 }
    }
  ],
  "outputs": {
    "projected": {
      "source": "projected",
      "formats": {
        "json": {
          "exporter": {
            "definition": "counted_json",
            "version": "1"
          }
        },
        "text": {}
      }
    },
    "reactive": {
      "source": "reactive",
      "formats": {
        "json": {}
      }
    },
    "reactive_markup": {
      "source": "reactive_markup",
      "formats": {
        "html": {}
      }
    },
    "chart": {
      "source": "chart",
      "formats": {
        "vegalite": {}
      }
    },
    "calculation": {
      "source": {
        "expression": "{'scale': scale, 'multiplier': multiplier.value, 'result': reactive['value']}"
      },
      "formats": {
        "json": { "options": { "indent": 2 } }
      }
    }
  }
}
