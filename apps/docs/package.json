{
  "name": "@marimo-team/marimo-export-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-navigation.ts && vitepress build && node scripts/check-built-docs.ts",
    "check:built": "node scripts/check-built-docs.ts",
    "check:navigation": "node scripts/check-navigation.ts",
    "dev": "portless",
    "dev:server": "vitepress dev",
    "preview": "vitepress preview --host 127.0.0.1 --port 54173 --strictPort",
    "test": "node scripts/check-navigation.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "1.13.5",
    "vue": "catalog:"
  },
  "portless": {
    "name": "docs.marimo-export",
    "script": "dev:server"
  }
}
